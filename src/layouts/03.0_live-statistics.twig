{% extends "@components/base/base.twig" %} {% set title = "03.0_live-statistics"
%} {% block main %}
<section class="match-header">
  <div class="container position-relative">
    <a href="#" class="match-header__back">
      {% include "@images/arrow-left.svg" %} Zpět na detail utkání
    </a>

    <div class="match-header__meta">
      <div class="text-bold-11 text-white">Maxa NBL</div>
      <span> | </span>
      <div class="text-13 text-slate-300">
        <div class="d-sm-inline d-none">Základní část,</div>
        18. kolo
      </div>
      <span> | </span>
      <div class="text-13 text-slate-300">
        So 24. 10.
        <div class="d-sm-inline d-none">2026,</div>
        18:00
      </div>
      <span> | </span>
      <div class="text-13 text-slate-300">Královka</div>
    </div>

    <div class="match-header__scoreboard">
      <div class="match-header__team">
        <img
          src="images/ico/slavia.svg"
          alt="SK Slavia Praha"
          class="match-header__logo"
        />
        <h2 class="match-header__team-name">
          <div class="d-md-block d-none">SK Slavia Praha</div>
          <div class="d-md-none d-block">Slavia</div>
        </h2>
        <div class="match-header__timeouts">
          <span class="is-active"></span>
          <span class="is-active"></span>
          <span></span>
        </div>
      </div>

      <div class="match-header__score">
        <div class="match-header__live">
          {% include "@images/live-dot.svg" %} LIVE
        </div>

        <div class="match-header__period">
          <span>3. čtvrtina</span>
          <strong>04:12</strong>
        </div>

        <div class="match-header__numbers">
          <span>63</span>
          <span class="text-slate-300">:</span>
          <span>58</span>
        </div>
      </div>

      <div class="match-header__team">
        <img
          src="images/ico/opava.svg"
          alt="BK Opava"
          class="match-header__logo"
        />
        <h2 class="match-header__team-name">
          <div class="d-md-block d-none">BK Opava</div>
          <div class="d-md-none d-block">Opava</div>
        </h2>
        <div class="d-md-block d-none"></div>
        <div class="match-header__timeouts">
          <span class="is-active"></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <div class="match-header__tables">
      <div class="match-header__table">
        <h3 class="match-header__table-title">Skóre po čtvrtinách</h3>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>1</th>
                <th>2</th>
                <th>3</th>
                <th>4</th>
                <th>P</th>
                <th>Celkem</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th class="match-header__home">SLA</th>
                <td>22</td>
                <td>19</td>
                <td class="is-current">22</td>
                <td>–</td>
                <td>–</td>
                <td><strong>63</strong></td>
              </tr>
              <tr>
                <th class="match-header__away">OPA</th>
                <td>18</td>
                <td>21</td>
                <td class="is-current">19</td>
                <td>–</td>
                <td>–</td>
                <td><strong>58</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="match-header__table">
        <h3 class="match-header__table-title">Týmové fouly</h3>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>1</th>
                <th>2</th>
                <th>3</th>
                <th>4</th>
                <th>P</th>
                <th></th>
