                <td>7</td>
                <td class="is-current">4</td>
                <td>–</td>
                <td>–</td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
<nav class="match-tabs" aria-label="Navigace zápasu">
  <div class="container">
    <div class="match-tabs__inner">
      <a href="#" class="match-tabs__link"> Přehled </a>

